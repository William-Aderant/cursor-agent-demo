# =============================================================================
# MCP Server Configuration
# =============================================================================
# Copy this file to .env and fill in your credentials.
# See SETUP_GUIDE.md for detailed instructions on obtaining each credential.

# -----------------------------------------------------------------------------
# GitHub MCP — personal access token with repo scope
# -----------------------------------------------------------------------------
# How to get: GitHub → Settings → Developer settings → Personal access tokens
# Required scopes: repo (full control of private repositories)
# Purpose: Allows agent to create PRs, fetch CI logs, read repository info
GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# Apidog MCP (optional — not used when OpenAPI file is configured)
# -----------------------------------------------------------------------------
# This project uses openapi.yaml at repo root instead. Omit these unless you
# switch .cursor/mcp.json back to Apidog.
# APIDOG_PROJECT_ID=
# APIDOG_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Postgres MCP — connection string for your dev database
# -----------------------------------------------------------------------------
# Format: postgresql://username:password@host:port/database
# Local example: postgresql://postgres:password@localhost:5432/mydb
# Cloud example: Copy connection string from Supabase/Neon/Railway dashboard
# Purpose: Allows agent to inspect schema, verify migrations, run queries
DEV_DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# -----------------------------------------------------------------------------
# Backend API — database for Alembic and FastAPI (can match DEV_DATABASE_URL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/mydb
